# Шаблон. Скопируй в .env и заполни своими значениями.
# .env — только для локальной разработки. На хостинге переменные задаются в
# панели, и они имеют приоритет над файлом.
# Реальные ID и телефоны здесь держать нельзя: файл лежит в git.

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Channel link (кнопка «Канал» в меню)
CHANNEL_LINK=https://t.me/your_channel

# Master contact
MASTER_USERNAME=your_username
MASTER_PHONE=+7 000 000-00-00
MASTER_NAME=Имя

# Admins: first ID = primary (master), rest = support.
# Свой ID можно узнать так: напиши боту /start — он покажет ID, если ты админ,
# иначе ID появится в логе при попытке открыть /admin.
ADMIN_TELEGRAM_IDS=

# Prepayment
PAYMENT_LINK=https://paylink.example.com/your-payment-id
PREPAYMENT_AMOUNT=500 ₽
SLOT_HOLD_MINUTES=15

# Database
# Локально:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Bothost (обязательно volume /app/data — см. DEPLOY.md):
# DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db
# Postgres (managed DB):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

LOG_LEVEL=INFO

# REQUEST_TIMEOUT=120
